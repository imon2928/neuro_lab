# Copy to .env and edit.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Comma-separated. In production: yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, with scheme. Needed for HTTPS deployments, e.g. https://yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=
